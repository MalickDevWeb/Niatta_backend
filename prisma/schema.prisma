generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis()]
}

enum UserStatus {
  active
  suspended
}

enum EntityStatus {
  active
  inactive
}

enum StoreSource {
  citizen_report
  admin
}

enum ReportStatus {
  pending
  under_review
  confirmed
  rejected
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  phone           String          @unique
  passwordHash    String
  status          UserStatus      @default(active)
  phoneVerifiedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  photoUrl        String?
  roles           UserRole[]
  observations    PriceObservation[]
  fieldVerifications FieldVerification[]
  pushSubscriptions PushSubscription[]
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  icon        String?
  description String?
  status      EntityStatus   @default(active)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    Product[]
}

model Product {
  id                String             @id @default(uuid()) @db.Uuid
  categoryId        String             @db.Uuid
  name              String
  slug              String             @unique
  icon              String?
  description       String?
  imageUrl          String?
  tags              String[]           // Tags pour la recherche (ex: Petit-déjeuner, Base)
  status            EntityStatus       @default(active)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  category          Category           @relation(fields: [categoryId], references: [id])
  formats           ProductFormat[]
  
  @@index([name])
}

model ProductFormat {
  id                String             @id @default(uuid()) @db.Uuid
  productId         String             @db.Uuid
  label             String             // Ex: "1 kg", "5 L", "Carton"
  unit              String             // Ex: "kg", "litre", "pièce"
  weight            String?
  imageUrl          String?            // Ex: "1kg", "5L"
  officialPriceCap  Decimal?           @db.Decimal(12, 2)  // Plafond légal pour ce format
  status            EntityStatus       @default(active)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  observations      PriceObservation[]

  @@unique([productId, label])
}

model Store {
  id             String             @id @default(uuid()) @db.Uuid
  name           String             @default("Point de vente observe")
  latitude       Decimal            @db.Decimal(10, 7)
  longitude      Decimal            @db.Decimal(10, 7)
  location       Unsupported("geometry(Point, 4326)")?
  city           String?
  neighborhood   String?
  address        String?            // Adresse complète lisible
  rating         Decimal?           @db.Decimal(3, 1)  // Note sur 5 (ex: 4.5)
  imageUrl       String?            // Photo principale (rétrocompatibilité)
  photos         String[]           @default([]) // Liste des photos (jusqu'à 3)
  status         EntityStatus       @default(active)
  source         StoreSource        @default(citizen_report)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  observations   PriceObservation[]
  
  @@index([latitude, longitude])
  @@index([location], name: "store_location_idx", type: Gist)
}

model PriceObservation {
  id               String          @id @default(uuid()) @db.Uuid
  storeId          String          @db.Uuid
  productFormatId  String          @db.Uuid
  userId           String          @db.Uuid
  price            Decimal         @db.Decimal(12, 2)
  latitude         Decimal         @db.Decimal(10, 7)
  longitude        Decimal         @db.Decimal(10, 7)
  location         Unsupported("geometry(Point, 4326)")?
  city             String?
  neighborhood     String?
  photoUrl         String?
  comment          String?
  status           ReportStatus    @default(pending)
  observedAt       DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  store            Store           @relation(fields: [storeId], references: [id])
  productFormat    ProductFormat   @relation(fields: [productFormatId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  fieldVerifications FieldVerification[]
  
  @@index([storeId, productFormatId, userId, observedAt])
  @@index([location], name: "observation_location_idx", type: Gist)
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GatheringPoint {
  id          String   @id @default(uuid()) @db.Uuid
  label       String   @default("Lieu du Rassemblement")
  description String?
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FieldVerification {
  id              String           @id @default(uuid()) @db.Uuid
  observationId   String           @db.Uuid
  agentId         String           @db.Uuid
  isConfirmed     Boolean
  actualPrice     Decimal?         @db.Decimal(12, 2)
  photoUrl        String?
  comment         String?
  createdAt       DateTime         @default(now())
  
  observation     PriceObservation @relation(fields: [observationId], references: [id])
  agent           User             @relation(fields: [agentId], references: [id])

  @@index([observationId, agentId, createdAt])
}